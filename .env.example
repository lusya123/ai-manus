# Model provider configuration
API_KEY=
API_BASE=http://mockserver:8090/v1

# Model configuration
# MODEL_PROVIDER selects the LLM integration (via LangChain init_chat_model).
# Built-in providers: openai, deepseek, anthropic, ollama. OpenAI-compatible
# endpoints (DeepSeek / OneAPI / vLLM / ...) work with openai + API_BASE.
# See docs/configuration.md for per-provider examples.
MODEL_PROVIDER=openai
MODEL_NAME=deepseek-chat
# JSON array of selectable per-chat models. API credentials remain backend-only;
# the frontend receives only safe metadata (id, label, model/provider/base URL).
#AVAILABLE_MODELS=[{"id":"gpt-4o","label":"GPT-4o","model_name":"gpt-4o","model_provider":"openai"}]
TEMPERATURE=0.7
MAX_TOKENS=2000

# LLM gateway provider: langchain (default) or openai.
# - langchain: uses init_chat_model, supports many providers via MODEL_PROVIDER.
# - openai:    talks to OpenAI / OpenAI-compatible endpoints (API_BASE) directly
#              via the official openai Python SDK (MODEL_PROVIDER is ignored).
#LLM_PROVIDER=langchain

# MongoDB configuration
#MONGODB_URI=mongodb://mongodb:27017
#MONGODB_DATABASE=manus
#MONGODB_USERNAME=
#MONGODB_PASSWORD=

# Redis configuration
#REDIS_HOST=redis
#REDIS_PORT=6379
#REDIS_DB=0
#REDIS_PASSWORD=
#REDIS_SOCKET_CONNECT_TIMEOUT=5.0
#REDIS_SOCKET_TIMEOUT=5.0
#REDIS_HEALTH_CHECK_INTERVAL=30
#REDIS_MAX_CONNECTIONS=100
#REDIS_RETRY_ATTEMPTS=3
# Redis is security state, not a disposable cache: authentication rate limits,
# used-refresh markers, token-family revocation, and distributed leases depend on
# it. Bundled Compose enables AOF everysec + noeviction on a named volume. Give
# an external production Redis equivalent durable storage, backups, and HA. A
# host crash can still lose about one second, so Redis is not a hard cost ledger.

# Sandbox configuration
# Provider: docker (default, local containers) or agentbay (Alibaba Cloud)
#SANDBOX_PROVIDER=docker
#SANDBOX_ADDRESS=
# Leave unset to use simpleyyt/manus-sandbox outside Compose, or to let the
# production Compose derive the runtime image from IMAGE_REGISTRY/IMAGE_TAG.
#SANDBOX_IMAGE=
SANDBOX_NAME_PREFIX=sandbox
SANDBOX_TTL_MINUTES=30
SANDBOX_NETWORK=manus-network
# Bound every local Docker sandbox even when it executes hostile or runaway
# model-generated code. Set an empty value only when an external runtime layer
# enforces equivalent limits.
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0
SANDBOX_PIDS_LIMIT=512
# Dynamic Docker runtimes use two owner-labelled bridges per sandbox/Claw:
# an internal control bridge and a one-container outbound bridge. The configured
# legacy bridge is retained only so one already-running runtime can survive a
# non-destructive upgrade. Startup fails closed if multiple old user runtimes
# still share it. Disable isolation only when an external layer enforces
# equivalent per-runtime segmentation.
RUNTIME_NETWORK_ISOLATION=true
#RUNTIME_GATEWAY_CONTAINER=
# Override if 10.240.0.0/12 overlaps a host/VPN route. Each live runtime uses
# two deterministic /28s; Docker atomically rejects and probes past collisions.
#RUNTIME_NETWORK_ADDRESS_POOL=10.240.0.0/12
#RUNTIME_NETWORK_SUBNET_PREFIX=28
# AutoRemove may delete an idle runtime before its session. The backend scans
# and removes its two orphan bridges after this grace window.
#RUNTIME_NETWORK_GC_INTERVAL_SECONDS=60
#RUNTIME_NETWORK_GC_GRACE_SECONDS=300
# This segmentation blocks runtime-to-runtime and runtime-to-datastore paths.
# It does not by itself block a runtime from the Docker host gateway, VPC/RFC1918
# ranges, link-local addresses, or cloud metadata. Enforce that broader egress
# policy with host firewall rules or a destination-filtering proxy when needed.
# Never point the legacy runtime bridge at `manus-data-network`, which is
# reserved for backend-to-MongoDB/Redis traffic.
#SANDBOX_CHROME_ARGS=
#SANDBOX_HTTPS_PROXY=
#SANDBOX_HTTP_PROXY=
#SANDBOX_NO_PROXY=

# Host ports used only by docker-compose-development.yml. These are deliberately
# separate from SANDBOX_*_PORT, which are the service ports inside the sandbox.
# Development infrastructure binds to loopback by default; change this only
# when remote access is intentional and protected by a firewall.
# run.sh and dev.sh deliberately use different Compose projects. Override only
# when you also preserve that production/development separation.
#COMPOSE_PROJECT_NAME=ai-manus
#DEV_COMPOSE_PROJECT_NAME=ai-manus-dev
# Stable per-deployment scope for dynamic Docker runtime names/labels. Keep it
# unchanged across releases; use a different value for every Compose project
# sharing one Docker daemon. run.sh/dev.sh derive it from their project name.
#RUNTIME_DEPLOYMENT_ID=ai-manus
# Prefix for production Compose control/data networks and Mongo/Redis volumes.
# run.sh preserves "manus" for the default project and derives a unique value
# for custom COMPOSE_PROJECT_NAME deployments on the same Docker host.
#CORE_RESOURCE_PREFIX=manus
#DEV_BIND_ADDRESS=127.0.0.1
#FRONTEND_PORT=5173
#BACKEND_PORT=8000
#DEBUGPY_HOST_PORT=5678
#CLAW_HOST_PORT=18788
#SANDBOX_HOST_API_PORT=8080
#SANDBOX_HOST_CDP_PORT=9222
#SANDBOX_HOST_RFB_PORT=5902
#SANDBOX_HOST_VNC_PORT=5901
#MONGODB_HOST_PORT=27017
#REDIS_HOST_PORT=6379
# If you change any published host port, also update the matching *_PUBLIC_URL
# below. Generated links must describe the port that users can actually reach.

# Published frontend port used by docker-compose.yml.
#FRONTEND_HOST_PORT=5173
# The optional fork deployment workflow preserves this fork's historical port
# with repository variable FORK_FRONTEND_HOST_PORT (default: 18081).

# AgentBay sandbox configuration (only used when SANDBOX_PROVIDER=agentbay)
# API key from https://agentbay.console.aliyun.com (or the international console)
#AGENTBAY_API_KEY=
# Region id, e.g. ap-southeast-1 (Singapore); leave unset for the SDK default
#AGENTBAY_REGION_ID=
# Custom image ID built from sandbox/ and registered in the AgentBay console
#AGENTBAY_IMAGE_ID=
# Stable, unique deployment name shared by every backend/worker replica.
# Do not change it casually: it identifies the durable Mongo cost ledger.
#AGENTBAY_DEPLOYMENT_ID=
# Increment only through the explicit quota-ledger migration procedure.
#AGENTBAY_QUOTA_CONFIG_VERSION=1
# Cross-replica hard cost caps (global hard maximum is 20).
#AGENTBAY_MAX_SESSIONS_TOTAL=20
#AGENTBAY_MAX_SESSIONS_PER_USER=3
#AGENTBAY_QUOTA_COMMAND_TIMEOUT_SECONDS=2
# Gateway ports must remain in AgentBay's default 30100-30199 range and match
# the socat listeners baked into sandbox/supervisord.conf.
#AGENTBAY_API_PORT=30150
#AGENTBAY_CDP_PORT=30151
#AGENTBAY_VNC_PORT=30152

# Browser engine configuration
# Options: playwright, browser_use (default)
# - playwright:   uses Playwright directly via CDP (stable, well-tested)
# - browser_use:  uses the browser_use library's BrowserSession via CDP
#                 (richer DOM state extraction via AI-friendly selector map)
#BROWSER_ENGINE=browser_use

# Runtime topology advertised to agents. Set every URL explicitly in production
# so generated commands do not guess between host, container, and public ports.
#DEPLOYMENT_ENVIRONMENT=development
#FRONTEND_PUBLIC_URL=http://localhost:5173
#BACKEND_PUBLIC_URL=http://localhost:8000
#FRONTEND_INTERNAL_URL=http://frontend-dev:5173
#BACKEND_INTERNAL_URL=http://backend:8000
#FRONTEND_SANDBOX_URL=http://frontend-dev:5173
#BACKEND_SANDBOX_URL=http://backend:8000
#CLAW_PUBLIC_URL=http://localhost:18788
#CLAW_INTERNAL_URL=http://claw:18788
#HOST_GATEWAY_URL=http://host.docker.internal

# Search engine configuration
# Options: anthropic_web, baidu, baidu_web, google, bing, bing_web, tavily, serper, custom
# anthropic_web: uses Anthropic's billed server-side web_search tool; requires
#                 MODEL_PROVIDER=anthropic and the configured model API key.
#                 Freshness/date_range filters fail closed because the API
#                 does not expose an enforceable search-date parameter. This
#                 one-shot provider also fails closed on pause_turn responses.
# For a non-official Anthropic-compatible gateway, bind both values explicitly;
# global EXTRA_HEADERS are intentionally never forwarded to search.
#ANTHROPIC_WEB_SEARCH_API_BASE=https://api.anthropic.com
#ANTHROPIC_WEB_SEARCH_API_KEY=
# baidu:    uses the Baidu Qianfan AI Search API (requires BAIDU_SEARCH_API_KEY)
# baidu_web: scrapes Baidu search results with browser impersonation (no API key needed)
# bing:     uses the official Bing Web Search API (requires BING_SEARCH_API_KEY)
# bing_web: scrapes Bing search results directly (no API key needed)
# tavily:   uses the Tavily Search API (requires TAVILY_API_KEY)
# serper:   uses the Serper.dev Google Search API (requires SERPER_API_KEY)
# custom:   calls any third-party search REST API via SEARCH_API_URL + SEARCH_API_KEY
SEARCH_PROVIDER=bing_web

# Bing web-scraping locale, only used when SEARCH_PROVIDER=bing_web.
# Pin a supported market instead of inheriting the cloud server's IP locale.
BING_WEB_MARKET=en-US
BING_WEB_SETLANG=en

# Baidu search configuration, only used when SEARCH_PROVIDER=baidu
# Get your API key from https://console.bce.baidu.com/qianfan/ais/console/onlineService
#BAIDU_SEARCH_API_KEY=

# Bing search configuration, only used when SEARCH_PROVIDER=bing
# Get your API key from https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
#BING_SEARCH_API_KEY=

# Google search configuration, only used when SEARCH_PROVIDER=google
#GOOGLE_SEARCH_API_KEY=
#GOOGLE_SEARCH_ENGINE_ID=

# Tavily search configuration, only used when SEARCH_PROVIDER=tavily
# Get your API key from https://tavily.com
#TAVILY_API_KEY=

# Serper.dev search configuration, only used when SEARCH_PROVIDER=serper
# Returns reliable Google results. Get your API key from https://serper.dev
#SERPER_API_KEY=

# Custom search API configuration, only used when SEARCH_PROVIDER=custom
# Allows integration with any third-party search REST API.
#
# Minimal setup (POST + Bearer token, e.g. a custom internal API):
#   SEARCH_API_URL=https://your-search-api.example.com/search
#   SEARCH_API_KEY=your-api-key
#
# Serper.dev via custom provider:
#   SEARCH_API_URL=https://google.serper.dev/search
#   SEARCH_API_KEY=your-serper-key
#   SEARCH_API_KEY_HEADER=X-API-KEY
#   SEARCH_API_KEY_HEADER_PREFIX=
#   SEARCH_RESULT_FIELD=organic
#
# SerpAPI via custom provider:
#   SEARCH_API_URL=https://serpapi.com/search
#   SEARCH_API_KEY=your-serpapi-key
#   SEARCH_API_KEY_PARAM=api_key
#   SEARCH_API_METHOD=GET
#   SEARCH_RESULT_FIELD=organic_results
#
# Brave Search API via custom provider:
#   SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
#   SEARCH_API_KEY=your-brave-key
#   SEARCH_API_KEY_HEADER=X-Subscription-Token
#   SEARCH_API_KEY_HEADER_PREFIX=
#   SEARCH_API_METHOD=GET
#   SEARCH_RESULT_FIELD=web.results
#   SEARCH_SNIPPET_FIELD=description
#
#SEARCH_API_URL=
#SEARCH_API_KEY=
#SEARCH_API_KEY_HEADER=Authorization
#SEARCH_API_KEY_HEADER_PREFIX=Bearer
#SEARCH_API_KEY_PARAM=
#SEARCH_API_METHOD=POST
#SEARCH_QUERY_FIELD=q
#SEARCH_RESULT_FIELD=results
#SEARCH_TITLE_FIELD=title
#SEARCH_LINK_FIELD=link
#SEARCH_SNIPPET_FIELD=snippet

# Google Analytics configuration
# Set your Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
#GOOGLE_ANALYTICS_ID=

# Exact comma-separated browser origins only (scheme + host + optional port).
# Wildcards, paths, query strings, credentials, and fragments are rejected.
# FRONTEND_PUBLIC_URL is also trusted automatically. Local development defaults
# to http://localhost:5173 and http://127.0.0.1:5173 when neither value is set.
#CORS_ALLOWED_ORIGINS=https://manus.example.com

# Auth configuration
# Options: password, none, local, sub2api
AUTH_PROVIDER=password
# Keep closed on Internet-facing deployments unless account creation is
# intentionally public and protected by the configured rate limits.
REGISTRATION_ENABLED=false
# Redis-authoritative authentication limits. Redis failure makes authentication
# temporarily unavailable instead of silently disabling replay/brute-force checks.
#AUTH_LOGIN_ATTEMPTS_PER_WINDOW=10
#AUTH_LOGIN_IP_ATTEMPTS_PER_WINDOW=30
#AUTH_LOGIN_WINDOW_SECONDS=300
#AUTH_REGISTER_ATTEMPTS_PER_HOUR=5
#AUTH_PASSWORD_RESET_ATTEMPTS_PER_HOUR=5
#AUTH_REFRESH_ATTEMPTS_PER_MINUTE=60

# Password auth configuration, only used when AUTH_PROVIDER=password
# New passwords use PBKDF2-SHA256 with a fresh random per-user salt. The old
# deployment-wide salt is migration-only: keep its historical value until all
# legacy users have logged in once and been upgraded, then remove it.
#PASSWORD_SALT=
PASSWORD_HASH_ROUNDS=600000
# Only used to verify and progressively upgrade hashes written by old releases.
PASSWORD_LEGACY_HASH_ROUNDS=10

# Local auth configuration, only used when AUTH_PROVIDER=local
#LOCAL_AUTH_EMAIL=admin@example.com
# Generate a unique value (for example: openssl rand -base64 32). Weak defaults
# are rejected outside explicit development/local/test environments.
#LOCAL_AUTH_PASSWORD=

# Sub2API auth configuration, only used when AUTH_PROVIDER=sub2api
#SUB2API_BASE_URL=http://localhost:3000
#SUB2API_LOGIN_URL=http://localhost:5173/manus/launch
#SUB2API_CONSOLE_URL=
#SUB2API_MARKETPLACE_URL=
#SUB2API_USE_TOKEN_URL=
#SUB2API_AUTH_ME_PATH=/api/v1/auth/me
#SUB2API_AUTH_REFRESH_PATH=/api/v1/auth/refresh
#SUB2API_TIMEOUT_SECONDS=10.0
# Must be at least the external provider's maximum opaque refresh-token age.
#SUB2API_REFRESH_TOKEN_MAX_AGE_DAYS=90

# JWT configuration
# Required whenever authentication is enabled and in staging/production, even
# with AUTH_PROVIDER=none. It must be non-default and at least 32 bytes; for
# example, generate one with: openssl rand -hex 32. A blank/default value is
# accepted only for disposable local development with AUTH_PROVIDER=none.
JWT_SECRET_KEY=
# Independent BYOK encryption keyring (JSON array). Generate every entry with
# `openssl rand -hex 32`; the first writes new records and the rest decrypt old
# records during rotation. Do not paste a shared example secret.
#MODEL_CREDENTIAL_ENCRYPTION_KEYS=[]
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Opaque Redis auth sessions (browser HttpOnly Cookie + App Bearer)
# /auth/login returns access_token = opaque session_id (not a JWT).
# Browser: Cookie session_id; App: Authorization: Bearer <session_id>
# WS: same Cookie / Bearer header — no ?token= query
#SESSION_COOKIE_NAME=session_id
#SESSION_WEB_TTL_DAYS=14
#SESSION_APP_TTL_DAYS=30
#SESSION_COOKIE_SECURE=false
#SESSION_COOKIE_SAMESITE=lax
#SESSION_JWT_GRACE_ENABLED=true

# Email configuration
# Only used when AUTH_PROVIDER=password
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USERNAME=your-email@gmail.com
#EMAIL_PASSWORD=
#EMAIL_FROM=your-email@gmail.com

# Claw (OpenClaw) configuration
# Enable or disable Claw feature (hides sidebar entry when false)
#CLAW_ENABLED=false
# Docker image used for Claw containers
#CLAW_IMAGE=simpleyyt/manus-claw
# Prefix for Claw container names
#CLAW_NAME_PREFIX=manus-claw
# Time-to-live for Claw containers in seconds. Persistent by default; set a
# positive TTL only for explicitly temporary development deployments.
#CLAW_TTL_SECONDS=0
# Docker network bridge name for Claw containers
CLAW_NETWORK=manus-network
# Max seconds to wait for Claw container to become ready
#CLAW_READY_TIMEOUT=300
# Fixed Claw address (single-user AUTH_PROVIDER=none/local development only;
# skips Docker container creation)
#CLAW_ADDRESS=
# Internal bootstrap capability for a fixed Claw runtime. It is never exposed
# through the user API and is accepted only for its RUNNING owned record.
#CLAW_API_KEY=
# Publish dynamically allocated loopback ports for Docker-created Claw instances.
# This is required when the backend runs directly on the host.
#CLAW_PUBLISH_HOST_PORTS=true
#CLAW_HOST_BIND_ADDRESS=127.0.0.1
#CLAW_HTTP_CONTAINER_PORT=18788
#CLAW_GATEWAY_CONTAINER_PORT=18789
# Global capacity and cleanup controls. Running Claw instances are never
# idle-cleaned by default because they are persistent user workstations.
#CLAW_MAX_INSTANCES_TOTAL=20
#CLAW_IDLE_TIMEOUT_SECONDS=0
#CLAW_CLEANUP_INTERVAL_SECONDS=60
# Fixed external runtimes may opt out; owned dynamic containers are always
# destroyed before their database ownership record is deleted.
#CLAW_DESTROY_ON_DELETE=true
# Per-container Docker resource limits
#CLAW_MEMORY_LIMIT=1g
#CLAW_NANO_CPUS=1000000000
#CLAW_PIDS_LIMIT=256
# Claw model-proxy spend/abuse limits (enforced per owned runtime key)
#CLAW_PROXY_MAX_INPUT_BYTES=131072
#CLAW_PROXY_REQUESTS_PER_MINUTE=30
#CLAW_PROXY_MAX_CONCURRENT_REQUESTS=2
#CLAW_PROXY_REQUEST_LEASE_SECONDS=300
# Claw WebSocket turn coordination and bounded chat/file inputs
#CLAW_CHAT_TURN_LEASE_SECONDS=300
#CLAW_CHAT_MAX_MESSAGE_BYTES=65536
#CLAW_CHAT_MAX_RESPONSE_BYTES=262144
#CLAW_CHAT_MAX_DURATION_SECONDS=300
#CLAW_CHAT_MAX_UPSTREAM_EVENT_BYTES=524288
#CLAW_CHAT_MAX_UPSTREAM_STREAM_BYTES=2097152
#CLAW_EVENT_QUEUE_MAX_BYTES=524288
#CLAW_CHAT_MAX_ATTACHMENTS=10
#CLAW_CHAT_MAX_ATTACHMENT_BYTES=26214400
#CLAW_CHAT_MAX_TOTAL_ATTACHMENT_BYTES=52428800
#CLAW_UPLOAD_MAX_BYTES=26214400
#CLAW_HISTORY_MAX_MESSAGES=128
# Aggregate BSON budget for embedded Claw history. Must exceed the largest
# permitted Claw stream record and may not exceed 12 MiB, leaving MongoDB
# document headroom below its hard 16 MiB limit.
#CLAW_HISTORY_MAX_BYTES=8388608
# Independent current,previous... HMAC keyring. Generate every entry with
# `openssl rand -hex 32`. Configure this before rotating
# JWT_SECRET_KEY; keep the previous entry until all active Claws have rehashed.
# When moving from the JWT fallback, put the old JWT_SECRET_KEY in a previous
# slot for one rotation window so existing runtime keys can be lazily rehashed.
# Each entry must be at least 32 bytes. Do not paste a shared example secret.
#CLAW_API_KEY_HMAC_KEYS=
# Total multipart HTTP body budget, enforced before UploadFile parsing. Keep
# the frontend Nginx client_max_body_size at least as large as this value.
#MULTIPART_UPLOAD_MAX_BODY_BYTES=27262976
# GridFS limits. The per-user byte/file counters are reserved atomically before
# upload; Claw uploads are subject to these limits as well as CLAW_UPLOAD_MAX_BYTES.
#FILE_UPLOAD_MAX_BYTES=26214400
#FILE_STORAGE_MAX_BYTES_PER_USER=1073741824
#FILE_STORAGE_MAX_FILES_PER_USER=1000
# Main Session.events is a recent projection; durable per-turn replay remains
# in the separate turn-output collection. Both limits are enforced atomically.
# The aggregate BSON ceiling may not exceed 6 MiB because Session.files shares
# MongoDB's 16 MiB document budget and may retain up to the per-user file cap.
#SESSION_HISTORY_MAX_EVENTS=512
#SESSION_EVENT_MAX_BYTES=262144
#SESSION_HISTORY_MAX_BYTES=6291456
# Backend API URL used by Claw containers for callbacks. If omitted, the backend
# falls back through BACKEND_SANDBOX_URL / BACKEND_INTERNAL_URL / public URL.
#MANUS_API_BASE_URL=http://backend:8000

# Extra headers for LLM API requests (JSON format)
#EXTRA_HEADERS={"X-Custom-Header": "value"}

# Task backend configuration
# local: run agent tasks in-process (default)
# celery: run agent tasks on distributed Celery workers
#         (requires a worker container, see docs/configuration.md)
#TASK_BACKEND=local
# Number of backend API processes/replicas. Values above 1 require Celery;
# the local task registry cannot be shared across Python processes.
#BACKEND_REPLICA_COUNT=1
# Optional custom Celery broker URL (defaults to the Redis settings above)
#CELERY_BROKER_URL=

# One-time credential migration only. Supply every historical deployment and
# model-catalog API key used by pre-marker releases, run the dry run and then
# `backend/scripts/migrate_agent_credentials.py --apply`, and remove this value.
# Never leave historical plaintext keys in a long-lived .env file.
#LEGACY_SYSTEM_API_KEYS=[]

# MCP configuration
#MCP_CONFIG_PATH=/etc/mcp.json

# Log configuration
LOG_LEVEL=INFO
